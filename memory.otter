// Windows VirtualAlloc ("kernel32.dll"): reserve/commit memory pages (Windows)
link "kernel32.dll" ~> VirtualAlloc(
  lpAddress:rawptr,
  dwSize:int,
  flAllocationType:int,
  flProtect:int
) -> rawptr;

// Windows VirtualFree ("kernel32.dll"): release committed memory pages (Windows)
link "kernel32.dll" ~> VirtualFree(
  lpAddress:rawptr,
  dwSize:int,
  dwFreeType:int
) -> bool;

// Windows RtlMoveMemory ("kernel32.dll"): copy a block of memory (Windows)
link "kernel32.dll" ~> RtlMoveMemory(
  destination:rawptr,
  source:rawptr,
  length:int
) -> void;

// Windows lstrlenA ("kernel32.dll"): length of a null-terminated string (Windows)
link "kernel32.dll" ~> lstrlenA(text:str) -> int;

// Linux mmap (syscall 9): map anonymous memory pages into the address space
link 9 ~> __linux_mmap(
  addr:rawptr,
  len:int,
  prot:int,
  flags:int,
  fd:int,
  off:int
) -> rawptr;

// Linux munmap (syscall 11): unmap previously mapped memory pages
link 11 ~> __linux_munmap(addr:rawptr, len:int) -> int;

// macOS mmap (syscall 33554629): map anonymous memory pages into the address space
link 33554629 ~> __macos_mmap(
  addr:rawptr,
  len:int,
  prot:int,
  flags:int,
  fd:int,
  off:int
) -> rawptr;

// macOS munmap (syscall 33554505 = 0x2000000 + BSD 73): unmap mapped pages
link 33554505 ~> __macos_munmap(addr:rawptr, len:int) -> int;

// Windows syscall (syscall 0): external system call
link 0 ~> syscall(
  num:int,
  a1:int,
  a2:int,
  a3:int,
  a4:int,
  a5:int,
  a6:int
) -> int;

/**
 * The heap: size-class segregated freelists over 64 KiB mmap arenas.
 *
 * Every block carries a 16-byte header:
 *   word0 = payload_capacity * 64 + class_id   (class 63 = large passthrough,
 *           where payload_capacity is the total mmap length)
 *   word1 = liveness magic: 2004318071 while live, 1717986918 after free.
 * The distinct FREE magic lets free() tell a double-free apart from wild
 * pointer corruption. Small classes (0..15) come from bump-allocated chunks
 * and are recycled through per-class LIFO freelists: one mmap syscall per
 * ~15-500 allocations instead of per allocation. Anything over 4096 bytes
 * maps straight through to mmap/munmap as before.
 *
 * Freelist-recycled blocks are re-zeroed before reuse so alloc() keeps the
 * mmap guarantee that memory arrives zero-filled (bignum code relies on it).
 * Chunks are never unmapped; RSS is bounded by each class's high-water mark.
 *
 * Control block layout (one lazily mmap'd page, reached via __heap_ctl):
 *   +0             spin lock word
 *   +8   .. +127   freelist head per class (16 slots)
 *   +136 .. +255   bump cursor per class
 *   +264 .. +383   bump end per class
 * The first allocation always happens on the main thread (worker threads
 * are only created by thread.spawn, which itself allocates first), so the
 * lazy init needs no synchronization; later concurrent alloc/free take the
 * spin lock.
 */

global __heap_ctl:int = 0;

// Raw anonymous rw mmap of n bytes (Unix only; callers guard PLATFORM).
~> __heap_mmap(n:int) -> rawptr {
  match (PLATFORM) {
    0 -> { return __linux_mmap(null, n, 3, 34, -1, 0); };
    2 -> { return __macos_mmap(null, n, 3, 4098, -1, 0); };
    _ -> { return null; };
  }
}

// Size class for a payload size (1..4096). 0..7 cover 16..128 in steps of
// 16; 8..15 cover 192, 256, 384, 512, 768, 1024, 2048, 4096.
~> __heap_class(size:int) -> int {
  match (size <= 128) { true -> { return (size + 15) / 16 - 1; }; _ -> {}; }
  match (size <= 192) { true -> { return 8; }; _ -> {}; }
  match (size <= 256) { true -> { return 9; }; _ -> {}; }
  match (size <= 384) { true -> { return 10; }; _ -> {}; }
  match (size <= 512) { true -> { return 11; }; _ -> {}; }
  match (size <= 768) { true -> { return 12; }; _ -> {}; }
  match (size <= 1024) { true -> { return 13; }; _ -> {}; }
  match (size <= 2048) { true -> { return 14; }; _ -> {}; }
  return 15;
}

// Payload capacity of a size class.
~> __heap_class_size(c:int) -> int {
  match (c < 8) { true -> { return (c + 1) * 16; }; _ -> {}; }
  match (c == 8) { true -> { return 192; }; _ -> {}; }
  match (c == 9) { true -> { return 256; }; _ -> {}; }
  match (c == 10) { true -> { return 384; }; _ -> {}; }
  match (c == 11) { true -> { return 512; }; _ -> {}; }
  match (c == 12) { true -> { return 768; }; _ -> {}; }
  match (c == 13) { true -> { return 1024; }; _ -> {}; }
  match (c == 14) { true -> { return 2048; }; _ -> {}; }
  return 4096;
}

// Acquire/release the heap spin lock (lock word at ctl+0).
~> __heap_lock(ctl:rawptr) -> void {
  flow spinning:bool = true;
  loop (spinning) {
    rock got:int = __otter_cas64(ctl, 0, 1);
    match (got == 0) { true -> { spinning = false; }; _ -> {}; }
  }
}

~> __heap_unlock(ctl:rawptr) -> void {
  __otter_atomic_store64(ctl, 0);
}

/**
 * Allocates a contiguous block of memory (zero-filled).
 * On Windows, uses VirtualAlloc with MEM_COMMIT (0x1000) and PAGE_READWRITE (4).
 * On Linux/macOS, small sizes (<= 4096) come from size-class freelists over
 * 64 KiB mmap arenas; larger sizes map straight through to mmap. See the
 * heap comment above for the header format and locking rules.
 * @param size  Number of usable bytes to allocate (minimum 1)
 * @returns     Pointer to the usable region, or null on failure
 */
~> alloc(size:int) -> rawptr {
  match (PLATFORM) {
    1 -> { return VirtualAlloc(null, size, 4096, 4); };
    0 -> {};
    2 -> {};
    _ -> { return VirtualAlloc(null, size, 4096, 4); };
  }

  flow want:int = size;
  match (want < 1) { true -> { want = 1; }; _ -> {}; }

  // Large allocations: straight mmap, class id 63, word0 holds mmap length.
  match (want > 4096) {
    true -> {
      rock total:int = want + 16;
      rock big:rawptr = __heap_mmap(total);
      match (big == null) { true -> { return null; }; _ -> {}; }
      *big = total * 64 + 63;
      rock bmagic:rawptr = big @ 8;
      *bmagic = 2004318071;
      return big @ 16;
    };
    _ -> {};
  }

  // Lazy init: first allocation is always on the main thread.
  match (__heap_ctl == 0) {
    true -> {
      rock cb:rawptr = __heap_mmap(4096);
      match (cb == null) { true -> { return null; }; _ -> {}; }
      __heap_ctl = (int)cb;
    };
    _ -> {};
  }
  rock ctl:rawptr = (rawptr)__heap_ctl;

  rock c:int = __heap_class(want);
  rock csize:int = __heap_class_size(c);

  __heap_lock(ctl);

  // 1. Freelist hit: pop, re-zero the payload, restamp the header.
  rock head_slot:rawptr = ctl @ (8 + c * 8);
  rock head:int = *head_slot;
  match (head != 0) {
    true -> {
      rock blk:rawptr = (rawptr)head;
      *head_slot = *blk;              // next pointer lives in payload word 0
      __heap_unlock(ctl);
      flow z:int = 0;
      loop (z < csize) {
        rock zp:rawptr = blk @ z;
        *zp = 0;
        z += 8;
      }
      rock hdr:rawptr = blk @ -16;
      *hdr = csize * 64 + c;
      rock hmagic:rawptr = hdr @ 8;
      *hmagic = 2004318071;
      return blk;
    };
    _ -> {};
  }

  // 2. Bump-allocate from the class's current chunk (fresh mmap memory is
  //    already zeroed, so no memset here).
  rock stride:int = csize + 16;
  rock bump_slot:rawptr = ctl @ (136 + c * 8);
  rock end_slot:rawptr = ctl @ (264 + c * 8);
  flow cur:int = *bump_slot;
  rock limit:int = *end_slot;
  match (cur == 0 || cur + stride > limit) {
    true -> {
      rock chunk:rawptr = __heap_mmap(65536);
      match (chunk == null) {
        true -> { __heap_unlock(ctl); return null; };
        _ -> {};
      }
      cur = (int)chunk;
      *end_slot = cur + 65536;
    };
    _ -> {};
  }
  *bump_slot = cur + stride;
  __heap_unlock(ctl);

  rock base:rawptr = (rawptr)cur;
  *base = csize * 64 + c;
  rock magic_slot:rawptr = base @ 8;
  *magic_slot = 2004318071;
  return base @ 16;
}

/**
 * Releases a previously allocated memory block.
 * On Windows, calls VirtualFree with MEM_RELEASE (0x8000).
 * On Linux/macOS, verifies the liveness magic (a block that is already FREE
 * panics as a double free; anything else panics as corruption), marks the
 * block FREE, then either pushes it onto its size-class freelist or, for
 * large blocks, munmaps it. Passing null is a safe no-op.
 * @param ptr  Pointer obtained from alloc(), or null
 */
~> free(ptr:rawptr) {
  match (ptr == null) {
    true -> { return; };
    _ -> {};
  }

  match (PLATFORM) {
    1 -> { VirtualFree(ptr, 0, 32768); return; };
    _ -> {};
  }

  rock base:rawptr = ptr @ -16;
  rock magic_slot:rawptr = base @ 8;
  rock magic:int = *magic_slot;
  match (magic == 2004318071) {
    true -> {};
    _ -> {
      match (magic == 1717986918) {
        true -> { __otter_panic("otter: double free\n", 134); };
        _ -> { __otter_panic("otter: heap corruption (freeing an invalid pointer)\n", 134); };
      }
    };
  }
  *magic_slot = 1717986918;

  rock word0:int = *base;
  rock c:int = word0 % 64;

  // Large block: give the pages back.
  match (c == 63) {
    true -> {
      rock total:int = word0 / 64;
      match (PLATFORM) {
        0 -> { __linux_munmap(base, total); };
        2 -> { __macos_munmap(base, total); };
        _ -> {};
      }
      return;
    };
    _ -> {};
  }

  // Small block: push onto its class freelist (next pointer in payload).
  rock ctl:rawptr = (rawptr)__heap_ctl;
  __heap_lock(ctl);
  rock head_slot:rawptr = ctl @ (8 + c * 8);
  *ptr = *head_slot;
  *head_slot = (int)ptr;
  __heap_unlock(ctl);
}

/**
 * Copies n bytes from src to dst, returning dst.
 * On Windows, delegates to kernel32 RtlMoveMemory.
 * On Unix, performs a manual 8-byte-word copy loop followed by a
 * partial-word copy for any remaining bytes using bitmask merging.
 * @param dst  Destination pointer
 * @param src  Source pointer
 * @param n    Number of bytes to copy
 * @returns    The destination pointer
 */
~> memcpy(dst:rawptr, src:rawptr, n:int) -> rawptr {
  match (PLATFORM_WINDOWS) {
    true -> {
      RtlMoveMemory(dst, src, n);
      return dst;
    };
    _ -> {
      flow i:int = 0;
      flow words:int = n / 8;

      loop (i < words) {
        rock offset:int = i * 8;
        rock s_ptr:rawptr = src @ offset;
        rock d_ptr:rawptr = dst @ offset;
        *d_ptr = *s_ptr;
        i += 1;
      }

      rock rem:int = n % 8;
      match (rem > 0) {
        true -> {
          rock offset_rem:int = words * 8;
          rock s_ptr_rem:rawptr = src @ offset_rem;
          rock d_ptr_rem:rawptr = dst @ offset_rem;

          rock src_word:int = *s_ptr_rem;
          rock dst_word:int = *d_ptr_rem;

          rock shift:int = rem * 8;
          flow mask:int = 1;
          flow j:int = 0;
          loop (j < shift) {
            mask = mask * 2;
            j += 1;
          }
          mask -= 1;

          rock src_part:int = src_word & mask;
          rock dst_mask:int = dst_word & mask;
          rock dst_part:int = dst_word - dst_mask;

          rock combined:int = src_part + dst_part;
          *d_ptr_rem = combined;
        };
        _ -> {};
      }
      return dst;
    };
  }
}

/**
 * Returns the byte length of a null-terminated string, excluding the terminator.
 * On Windows, delegates to kernel32 lstrlenA.
 * On Unix, performs a manual byte-by-byte scan checking for a zero byte
 * by masking each 8-byte word with 0xFF.
 * @param text  The null-terminated string to measure
 * @returns     Number of bytes before the null terminator
 */
~> strlen(text:str) -> int {
  match (PLATFORM_WINDOWS) {
    true -> {
      return lstrlenA(text);
    };
    _ -> {
      flow i:int = 0;
      flow done:bool = false;
      loop (!done) {
        rock p:rawptr = text @ i;
        rock word:int = *p;
        rock b:int = word & 255;
        match (b == 0) {
          true -> {
            done = true;
          };
          _ -> {
            i += 1;
          };
        }
      }
      return i;
    };
  }
}

